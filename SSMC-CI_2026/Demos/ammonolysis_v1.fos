	[]
    
// Treatments are anything that you do to facilitate the reaction. Any
// treatments done to a material before the reaction should be listed in that
// material's treatments (above). This section is for treatments combining or
// modifying multiple materials at once.
[[Treatments]]
:type
:repeats
:observations

	grind
	1
	[;;;
    	Grind precursor by hand with mortar
	and pestle for 15 minutes]
	
	weigh
	1
	[;;;
    	Weigh approximately 100 mg with analytical balance
	and add to quartz boat]

	nitridation
	1
	[;;;
    	Load into tube furnace 
	and set ammonolysis conditions.
	Argon flows through custom made bubbler
	filled with DI water.
	Cool naturally while continuing gas flow
	at end of program.]
	start_temp: 25
	start_temp_unit: C
	program: [[
		type: ramp
		temp: 777
		temp_unit: C
		heat_rate: 5
		heat_rate_unit: C/min
		
		type: dwell
		time: 20
		time_unit: hr

		gas_1: argon
		gas_1_flow: 100
		gas_1_flow_unit: sccm

		gas_2: ammonia
		gas_2_flow: 150
		gas_2_flow_unit: sccm
		
		bubbler_pre_wt: 20.66
		bubbler_pre_wt_unit: oz
		bubbler_post_wt: 20.56 
		bubbler_post_wt_unit: oz
	]]

