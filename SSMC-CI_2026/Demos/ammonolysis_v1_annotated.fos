fos_id: E072-2
// fos_type is used to distinguish between template sets and syntheses
fos_type: synthesis
// description is the free field where ammonolysis can be mentioned
description: synthesis of beta tantalum oxynitride by ammonolysis

// two new required fields; will be used for database organization and
// permission setting (Users can be authorized to edit the entire group's
// dataset, or only certain projects.)
group_id: wenderott-0000-0001-8268-1249
project_id: b-TaON/ammonolysis

fos_date: 07/15/2025

[[Experimenters]]
name: Aksha Prince
// You had an empty orcid property, but orcid is still optional right now, so it can be omitted
affiliation: Wenderott Group - Drexel University

// We haven't set much expectations for this section yet... but the fact that
// every line starts with "lab_" hints that we could be a little more granular.
// Maybe a list of locations?
[Environments]
name: lab
temp: 27
temp_unit: C
humidity: 38
humidity_unit: %

// The new products heading that we added during SSMC might render this heading
// obsolete.
[Reaction]
target_product: beta tantalum oxynitride
nominal_formula: TaON
nominal_amount: 96.4
nominal_amount_unit: mg

// Information about expected or obtained products.
[Products]
name: beta tantalum oxynitride
formula: TaON
expected: true
obtained: true
expected_amount: 96.4
expected_amount_unit: mg 
obtained_amount: 97.8
obtained_amount_unit: mg
observations: light yellow powder

// FYI: These last two properties are definitely placeholders for more in-depth
// characterization format. Maybe a list of characterization objects with
// conclusions from each? Allow reference to attachment list?
characterizations: PXRD, UV-Vis, XPS
structure_comments: distorted Ta(O,N)6 octahedra with anion ordering


[[Materials]]
:name
:type
:formula
:supplier
:cas
:form
:color
:purity
:env
:amount
// omitted optional/empty treatments property
:amount_unit

	tantalum oxide
	precursor
	Ta2O5
	Thermo Fisher
	1314-61-0
	powder
	white
	0.9995
	// Currently "env" is expected as a text field, but I really like the idea
	// of having a list or object here instead. Maybe establish the environment
	// under the "environment" heading and reference it by name here?
	// (you had [] instead of ambient)
	ambient
	101.1
	mg
    

[[Treatments]]
// Since there's a really long treatment at the end with a lot of properties, I
// opted to make this an explicit-keyed list instead of the looped keys.
type: grind
repeats: 1
observations: [;;;
	Grind precursor by hand with mortar
and pestle for 15 minutes]

// FYI: we have classes in progress for more structured adding/removing of
// reagents/products/chemicals, but they still haven't been fully integrated
// into the examples.
type: weigh
repeats: 1
observations: [;;;
	Weigh approximately 100 mg with analytical balance
and add to quartz boat]

// the "type" of a treatment is used to assign special validation routines
// for it, so it's safer to use the closest existing type (annealing), then
// add custom properties as needed
type: annealing
repeats: 1
// Newest code should be able to recognize double line breaks as paragraphs
// and word-wrap them separately when saving.
observations: [;;;
Load into tube furnace 
and set ammonolysis conditions.

Argon flows through custom made bubbler
filled with DI water.

Cool naturally while continuing gas flow
at end of program.]

// the "$equipment" tag here makes sure the unique bubbler is identified as equipment.
bubbler$equipment: [
	pre_wt: 20.66
	pre_wt_unit: oz
	post_wt: 20.56 
	post_wt_unit: oz
]

start_temp: 25
start_temp_unit: C

// The "program" property is a list of steps, whereas (it seems) the gas flows
// are applied for the entire treatment, so they should be under their own
// property applying to the entire treatment instead of mixed in with the
// annealing program
gas_flow: [[
	gas: argon
	rate: 100
	rate_unit: cm^3/min

	gas: ammonia
	flow: 150
	flow_unit: cm^3/min
]]

program: [[
	type: ramp
	temp: 777
	temp_unit: C
	rate: 5
	rate_unit: C/min
	
	type: dwell
	time: 20
	time_unit: hr
]]


// We very recently changed the "cifs" header to "attachments", since anything
// can be attached now (either as embedded or path)
// If you want it to be called cifs anyway, you could use
// [[cifs$attachments]]
[attachments]
file_name: TaON_P121c1_(14)_Code1032.cif
